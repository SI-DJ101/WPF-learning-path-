<Window x:Class="Example_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Example_01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Button x:Name="btnStart" Width="135" Height="60" Content="Start"
            HorizontalAlignment="Left" VerticalAlignment="Top" 
            Margin="75,50,0,0"
            Background="LightBlue" Foreground="White"
            BorderBrush="Gray"
            FontFamily="Times New Roman" FontSize="26.667" FontWeight="Bold"
            IsEnabled="False"
            Click="btnStart_Click" />

        <Button x:Name="btnTime" Width="135" Height="60" Content="Czas"
            HorizontalAlignment="Left" VerticalAlignment="Top" 
            Margin="75,150,0,0"
            FontFamily="Times New Roman" FontSize="26.667" FontWeight="Bold"
            MouseEnter="btnTime_MouseEnter" MouseLeave="btnTime_MouseLeave" />

        <Button x:Name="btnEnableStart" Width="135" Height="30"
            Content="Aktywuj Start"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="275,65,0,0" 
            Click="btnEnableStart_Click" />
    </Grid>

</Window>
